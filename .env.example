# Groq is used only by the optional remote provider integrations.
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_MIN_REQUEST_INTERVAL_SECONDS=3.1
KOTHON_TRANSCRIPTION_CHUNK_SECONDS=90

# Runtime defaults
KOTHON_LANGUAGE_HINT=bn
KOTHON_OUTPUT_DIR=output
